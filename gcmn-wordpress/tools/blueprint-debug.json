{
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": false
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "elementor"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "activatePlugin",
      "pluginPath": "gcmn-core/gcmn-core.php"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "gcmn-theme"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; $r = gcmn_import_bundled(); echo wp_json_encode( $r ? $r['state']['counts'] : 'nothing to do' ); ?>"
    }
  ]
}